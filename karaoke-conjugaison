<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🎵 Karaoké des Chansons de Conjugaison</title>
<link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --song1: #FF6B6B;
    --song2: #4ECDC4;
    --song3: #FFE66D;
    --song4: #A29BFE;
    --song5: #FD79A8;
    --dark: #2d2d2d;
    --white: #fff;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Nunito', sans-serif;
    background: #1a1a2e;
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* STARS BACKGROUND */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      radial-gradient(1px 1px at 10% 20%, rgba(255,255,255,0.6) 0%, transparent 100%),
      radial-gradient(1px 1px at 30% 70%, rgba(255,255,255,0.4) 0%, transparent 100%),
      radial-gradient(1.5px 1.5px at 50% 40%, rgba(255,255,255,0.7) 0%, transparent 100%),
      radial-gradient(1px 1px at 70% 10%, rgba(255,255,255,0.5) 0%, transparent 100%),
      radial-gradient(1px 1px at 85% 60%, rgba(255,255,255,0.4) 0%, transparent 100%),
      radial-gradient(2px 2px at 20% 90%, rgba(255,255,255,0.3) 0%, transparent 100%),
      radial-gradient(1px 1px at 60% 80%, rgba(255,255,255,0.5) 0%, transparent 100%),
      radial-gradient(1.5px 1.5px at 90% 30%, rgba(255,255,255,0.6) 0%, transparent 100%);
    pointer-events: none;
    z-index: 0;
  }

  header {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 2.5rem 1rem 1.5rem;
  }

  header h1 {
    font-family: 'Fredoka One', cursive;
    font-size: clamp(2rem, 6vw, 3.5rem);
    color: #fff;
    text-shadow: 0 0 30px rgba(255,255,255,0.3);
    letter-spacing: 1px;
  }

  header h1 span {
    display: inline-block;
    animation: bounce 1.2s infinite alternate;
  }
  header h1 span:nth-child(2) { animation-delay: 0.1s; color: var(--song1); }
  header h1 span:nth-child(3) { animation-delay: 0.2s; color: var(--song2); }
  header h1 span:nth-child(4) { animation-delay: 0.3s; color: var(--song3); }
  header h1 span:nth-child(5) { animation-delay: 0.4s; color: var(--song4); }

  @keyframes bounce {
    from { transform: translateY(0); }
    to { transform: translateY(-6px); }
  }

  header p {
    color: rgba(255,255,255,0.6);
    font-size: 1rem;
    margin-top: 0.5rem;
    font-style: italic;
  }

  /* TABS */
  .tabs {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.7rem;
    padding: 0 1rem 1.5rem;
  }

  .tab-btn {
    font-family: 'Fredoka One', cursive;
    font-size: 1rem;
    padding: 0.6rem 1.4rem;
    border: none;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s ease;
    background: rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.7);
    border: 2px solid transparent;
    letter-spacing: 0.5px;
  }

  .tab-btn:hover {
    transform: translateY(-3px);
    background: rgba(255,255,255,0.2);
    color: #fff;
  }

  .tab-btn.active-1 { background: var(--song1); color: #fff; border-color: var(--song1); box-shadow: 0 0 20px rgba(255,107,107,0.5); }
  .tab-btn.active-2 { background: var(--song2); color: var(--dark); border-color: var(--song2); box-shadow: 0 0 20px rgba(78,205,196,0.5); }
  .tab-btn.active-3 { background: var(--song3); color: var(--dark); border-color: var(--song3); box-shadow: 0 0 20px rgba(255,230,109,0.5); }
  .tab-btn.active-4 { background: var(--song4); color: #fff; border-color: var(--song4); box-shadow: 0 0 20px rgba(162,155,254,0.5); }
  .tab-btn.active-5 { background: var(--song5); color: #fff; border-color: var(--song5); box-shadow: 0 0 20px rgba(253,121,168,0.5); }

  /* SONG PANELS */
  .song-panel {
    display: none;
    position: relative;
    z-index: 1;
    max-width: 800px;
    margin: 0 auto 3rem;
    padding: 0 1.2rem;
    animation: fadeIn 0.4s ease;
  }

  .song-panel.active { display: block; }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .song-card {
    background: rgba(255,255,255,0.05);
    backdrop-filter: blur(10px);
    border-radius: 24px;
    padding: 2rem 2.5rem;
    border: 1px solid rgba(255,255,255,0.1);
  }

  .song-header {
    text-align: center;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 2px dashed rgba(255,255,255,0.15);
  }

  .song-emoji {
    font-size: 3rem;
    display: block;
    margin-bottom: 0.5rem;
  }

  .song-title {
    font-family: 'Fredoka One', cursive;
    font-size: 2rem;
    margin-bottom: 0.3rem;
  }

  .panel-1 .song-title { color: var(--song1); }
  .panel-2 .song-title { color: var(--song2); }
  .panel-3 .song-title { color: var(--song3); }
  .panel-4 .song-title { color: var(--song4); }
  .panel-5 .song-title { color: var(--song5); }

  .song-subtitle {
    color: rgba(255,255,255,0.5);
    font-size: 0.9rem;
    font-style: italic;
  }

  /* LYRICS */
  .lyrics {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .block {
    background: rgba(255,255,255,0.04);
    border-radius: 16px;
    padding: 1.2rem 1.5rem;
    border-left: 4px solid transparent;
  }

  .panel-1 .block { border-left-color: var(--song1); }
  .panel-2 .block { border-left-color: var(--song2); }
  .panel-3 .block { border-left-color: var(--song3); }
  .panel-4 .block { border-left-color: var(--song4); }
  .panel-5 .block { border-left-color: var(--song5); }

  .block-label {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 0.7rem;
    opacity: 0.5;
    color: #fff;
  }

  .block p {
    color: rgba(255,255,255,0.9);
    font-size: 1.05rem;
    line-height: 1.9;
    font-weight: 600;
  }

  .block p strong {
    font-size: 1.1em;
  }

  .panel-1 .block p strong { color: var(--song1); }
  .panel-2 .block p strong { color: var(--song2); }
  .panel-3 .block p strong { color: var(--song3); }
  .panel-4 .block p strong { color: var(--song4); }
  .panel-5 .block p strong { color: var(--song5); }

  .refrain-block {
    background: rgba(255,255,255,0.08);
    border-radius: 16px;
    padding: 1.2rem 1.5rem;
    border: 2px solid rgba(255,255,255,0.15);
    text-align: center;
  }

  .refrain-block p {
    color: rgba(255,255,255,0.95);
    font-size: 1.1rem;
    line-height: 2;
    font-weight: 700;
  }

  .panel-1 .refrain-block p strong { color: var(--song1); }
  .panel-2 .refrain-block p strong { color: var(--song2); }
  .panel-3 .refrain-block p strong { color: var(--song3); }
  .panel-4 .refrain-block p strong { color: var(--song4); }
  .panel-5 .refrain-block p strong { color: var(--song5); }

  footer {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 1.5rem;
    color: rgba(255,255,255,0.25);
    font-size: 0.8rem;
  }

  @media (max-width: 600px) {
    .song-card { padding: 1.5rem 1.2rem; }
    .tab-btn { font-size: 0.85rem; padding: 0.5rem 1rem; }
  }
</style>
</head>
